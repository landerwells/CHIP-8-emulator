#include "chip.h"

#include <stdlib.h>
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

void load_rom(const char* filename, Chip8* chip) {
  FILE *file = fopen(filename, "rb");
  if (file == NULL) {
    perror("Error opening file");
    exit(EXIT_FAILURE);
  }

  uint16_t program_size = END_LOC - START_LOC;
  size_t bytesRead = fread(&chip->memory[START_LOC], sizeof(unsigned char), program_size, file);
  if (bytesRead < 0) {
    perror("Error reading file");
    exit(EXIT_FAILURE);
  }


  fclose(file); // Close the file

}

void op_00E0() {}

void op_00EE() {}

void op_1nnn(Chip8* chip) {
  program_counter = nnn;
}


void cycle(Chip8* chip) {
  chip->opcode = (chip->memory[chip->program_counter] << 8u) |
    chip->memory[chip->program_counter + 1];

  // Is there a real reason the chip has to know the opcode?
  uint16_t op = chip->opcode & 0xF000;
  uint16_t x = chip->opcode & 0x0F00;
  uint16_t y = chip->opcode & 0x00F0;
  uint16_t n = chip->opcode & 0x000F;
  uint16_t kk = chip->opcode & 0x00FF;
  uint16_t nnn = chip->opcode & 0x0FFF;

  chip->program_counter += 2;

  switch (op) {
    case 0x8000:
      break;
    case 0x0000:
      break;
    case 0xE000:
      break;
    case 0xF000:
      break;
    default:
      switch (op) {
        case 0x1000:
          op_1nnn();
          break;
        case 0x2000:
          op_2nnn();
          break;
        case 0x3000:
          op_3xkk();
          break;
        case 0x4000:
          op_4xkk();
          break;
        case 0x5000:
          op_5xy0();
          break;
        case 0x6000:
          op_6kxx();
          break;
        case 0x7000:
          op_7xkk();
          break;
        case 0x9000:
          op_9xy0();
          break;
        case 0xA000:
          op_Annn();
          break;
        case 0xB000:
          op_Bnnn();
          break;
        case 0xC000:
          op_Cxkk();
          break;
        case 0xD000:
          op_Dxyn();
          break;
        default:
          perror("Unknown opcode");
          exit(EXIT_FAILURE);
          break;
      }
      break;
  }

}

